<Window x:Class="FieldJobs.Views.InvoiceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invoice" Height="880" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}" MinWidth="660" MinHeight="640">
    <DockPanel Margin="22">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" Text="New invoice" Style="{StaticResource H1}" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button x:Name="DeleteButton" Content="Delete invoice" Style="{StaticResource Danger}"
                    DockPanel.Dock="Left" Click="Delete_Click" Visibility="Collapsed" MinWidth="120" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="90" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" />
                <Button Content="Save" MinWidth="90" Margin="0,0,8,0" Click="Save_Click" />
                <Button Content="Save &amp; open PDF" Style="{StaticResource Primary}" MinWidth="140" Click="SavePdf_Click" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,4,12,0">
                <TextBlock x:Name="JobText" Style="{StaticResource Muted}" Margin="0,0,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Invoice number" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NumberBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Invoice date" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="DateBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="StatusBox" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Date sent to Agency" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="SentDateBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Sent to" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SentToBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <TextBlock Text=" " Style="{StaticResource FieldLabel}" />
                        <Button Content="Mark sent today" Click="MarkSent_Click" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="OverdueText" Foreground="{DynamicResource BadBrush}" FontSize="12"
                           Margin="0,4,0,0" Visibility="Collapsed" />

                <TextBlock Text="Stage / section this invoice covers" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="StageBox" IsEditable="True" />

                <TextBlock Text="Line items" Style="{StaticResource H2}" Margin="0,14,0,4" />
                <DataGrid x:Name="LinesGrid" IsReadOnly="False" CanUserAddRows="True" AutoGenerateColumns="False"
                          CellEditEnding="Lines_CellEditEnding" MinHeight="140">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C2}" Width="110" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Tip: press Tab / Enter after the last row to add another line. Select a row and press Delete to remove it."
                           Style="{StaticResource Muted}" Margin="0,4,0,0" />

                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Billed" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BilledText" HorizontalAlignment="Right" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Paid" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PaidText" HorizontalAlignment="Right" Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource OkBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Balance" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BalanceText" HorizontalAlignment="Right" Margin="0,4,0,0" FontWeight="Bold" />
                    </Grid>
                </Border>

                <DockPanel Margin="0,16,0,4">
                    <Button DockPanel.Dock="Right" Content="Mark paid in full" Click="MarkPaid_Click" MinWidth="130" />
                    <TextBlock Text="Payments" Style="{StaticResource H2}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl x:Name="PaymentsList" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="PayDate" Grid.Column="0" />
                    <TextBox x:Name="PayAmount" Grid.Column="2" ToolTip="Amount received" />
                    <ComboBox x:Name="PayMethod" Grid.Column="4" />
                    <TextBox x:Name="PayReference" Grid.Column="6" ToolTip="Check # / ACH trace (optional)" />
                    <Button x:Name="AddPaymentButton" Grid.Column="8" Content="Add payment" MinWidth="110" Click="AddPayment_Click" />
                </Grid>
                <TextBox x:Name="PayNote" Margin="0,6,0,0" ToolTip="Note (optional)" />

                <!-- Documents -->
                <TextBlock Text="Documents" Style="{StaticResource H2}" Margin="0,16,0,4" />
                <TextBlock x:Name="DocsHint" Style="{StaticResource Muted}" Margin="0,0,0,6" TextWrapping="Wrap"
                           Text="Attach the invoice PDF you sent to Agency and the remittance / proof once it's paid." />
                <WrapPanel>
                    <Button Content="Attach sent invoice" Click="AttachSent_Click" Margin="0,0,8,8" />
                    <Button Content="Attach proof of payment" Click="AttachProof_Click" Margin="0,0,8,8" />
                    <Button Content="Attach other file" Click="AttachOther_Click" Margin="0,0,8,8" />
                </WrapPanel>
                <ItemsControl x:Name="DocsList" />
                <TextBlock x:Name="DocsEmpty" Text="No documents attached yet." Style="{StaticResource Muted}"
                           Visibility="Collapsed" Margin="0,2,0,0" />

                <TextBlock Text="Invoice notes" Style="{StaticResource FieldLabel}" Margin="0,14,0,3" />
                <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
