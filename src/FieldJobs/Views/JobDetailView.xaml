<UserControl x:Class="FieldJobs.Views.JobDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28,20,28,0">

        <!-- header -->
        <StackPanel DockPanel.Dock="Top">
            <Button Content="&#8592; Back to jobs" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                    Padding="0,2" Click="Back_Click" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Margin="0" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="Edit job" Click="Edit_Click" Margin="0,0,8,0" />
                    <Button Content="Job Summary PDF" Style="{StaticResource Primary}" Click="SummaryPdf_Click" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ProgressBar x:Name="Progress" Grid.Column="1" Maximum="100" Margin="16,0" />
                <TextBlock x:Name="PercentText" Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <TabControl x:Name="Tabs" Margin="0,12,0,0" Background="Transparent">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,12,16">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="OverviewGrid" />
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Money" Style="{StaticResource H2}" />
                                <UniformGrid Rows="1" Columns="3">
                                    <StackPanel><TextBlock Text="Billed" Style="{StaticResource Muted}" /><TextBlock x:Name="MBilled" Style="{StaticResource StatValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Paid" Style="{StaticResource Muted}" /><TextBlock x:Name="MPaid" Style="{StaticResource StatValue}" Foreground="{DynamicResource OkBrush}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Outstanding" Style="{StaticResource Muted}" /><TextBlock x:Name="MOut" Style="{StaticResource StatValue}" Foreground="{DynamicResource BadBrush}" /></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="My role" Style="{StaticResource H2}" />
                                <TextBlock x:Name="RoleText" TextWrapping="Wrap" />
                                <TextBlock Text="Notes" Style="{StaticResource H2}" Margin="0,14,0,8" />
                                <TextBlock x:Name="NotesText" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Stages">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,12,16">
                    <StackPanel>
                        <TextBlock Text="A later stage unlocks when the stage before it is marked Complete. Optional stages can be set to N/A."
                                   Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <ItemsControl x:Name="StageList" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Invoices">
                <DockPanel Margin="0,16,0,16">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="+ New invoice" Style="{StaticResource Primary}"
                                Click="NewInvoice_Click" />
                        <TextBlock Text="Invoices for this job" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="InvoicesGrid" MouseDoubleClick="Invoice_Open">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="110" />
                                <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate}" Width="110" />
                                <DataGridTextColumn Header="Stage / section" Binding="{Binding StageLabel}" Width="*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                <DataGridTextColumn Header="Billed" Binding="{Binding Billed, StringFormat=C}" Width="100" />
                                <DataGridTextColumn Header="Paid" Binding="{Binding Paid, StringFormat=C}" Width="100" />
                                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=C}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Files">
                <DockPanel Margin="0,16,0,16">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="+ Add file" Style="{StaticResource Primary}"
                                Click="AddFile_Click" />
                        <TextBlock Text="All files for this job" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="FilesGrid" MouseDoubleClick="File_Open">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File" Binding="{Binding OriginalName}" Width="*" />
                                <DataGridTextColumn Header="Stage" Binding="{Binding StageKey}" Width="160" />
                                <DataGridTextColumn Header="Added" Binding="{Binding DateAdded}" Width="150" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90" />
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open" Click="File_OpenMenu" />
                                    <MenuItem Header="Show in Explorer" Click="File_Reveal" />
                                    <MenuItem Header="Remove from job" Click="File_Remove" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Activity">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,12,16">
                    <StackPanel>
                        <TextBlock Text="Everything logged for this job, newest first." Style="{StaticResource Muted}"
                                   Margin="0,0,0,10" />
                        <Border Style="{StaticResource Card}">
                            <ItemsControl x:Name="ActivityList" />
                        </Border>
                        <TextBlock x:Name="ActivityEmpty" Text="Nothing logged yet." Style="{StaticResource Muted}"
                                   Margin="0,10,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
