<Window x:Class="FieldJobs.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FieldJobs" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource WindowBg}"
        MinWidth="960" MinHeight="600">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource NavText}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="6" Padding="12,10" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource NavSelectedBg}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Nav rail -->
        <Border Grid.Column="0" Background="{DynamicResource NavBg}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                    <TextBlock x:Name="BrandOrgText" Foreground="White" FontSize="19" FontWeight="Bold" />
                    <TextBlock x:Name="BrandAppText" Foreground="{DynamicResource NavText}" FontSize="13" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,12">
                    <TextBlock x:Name="DataPathText" Style="{StaticResource Muted}"
                               Foreground="{DynamicResource NavText}" TextWrapping="Wrap"
                               FontSize="10.5" Opacity="0.7" />
                </StackPanel>

                <StackPanel Margin="4,8">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Content="Dashboard"
                                 IsChecked="True" Checked="NavDashboard_Checked" />
                    <RadioButton x:Name="NavJobs" Style="{StaticResource NavButton}" Content="Jobs"
                                 Checked="NavJobs_Checked" />
                    <RadioButton x:Name="NavInvoices" Style="{StaticResource NavButton}" Content="Invoices"
                                 Checked="NavInvoices_Checked" />
                    <RadioButton x:Name="NavPayments" Style="{StaticResource NavButton}" Content="Payments"
                                 Checked="NavPayments_Checked" />
                    <RadioButton x:Name="NavReports" Style="{StaticResource NavButton}" Content="Reports"
                                 Checked="NavReports_Checked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Content="Settings"
                                 Checked="NavSettings_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl x:Name="Host" Grid.Column="1" Margin="0" />
    </Grid>
</Window>
