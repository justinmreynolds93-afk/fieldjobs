<UserControl x:Class="FieldJobs.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel MaxWidth="1180" HorizontalAlignment="Left">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Dashboard" Style="{StaticResource H1}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ New job" Style="{StaticResource Primary}" Click="NewJob_Click" Margin="0,0,8,0" />
                    <Button Content="Record payment" Click="RecordPayment_Click" Margin="0,0,8,0" />
                    <Button x:Name="ReportButton" Content="Report for Agency" Click="Report_Click" />
                </StackPanel>
            </Grid>

            <!-- needs attention -->
            <Border x:Name="AttentionCard" Style="{StaticResource Card}" Margin="0,0,0,16"
                    BorderBrush="{DynamicResource WarnBrush}">
                <StackPanel>
                    <TextBlock Text="Needs attention" Style="{StaticResource H2}" />
                    <ItemsControl x:Name="AttentionList" />
                </StackPanel>
            </Border>

            <!-- money row -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Outstanding receivables" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="StatOutstanding" Style="{StaticResource StatValue}" Foreground="{DynamicResource BadBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Total billed (all jobs)" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="StatBilled" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Total paid (all jobs)" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="StatPaid" Style="{StaticResource StatValue}" Foreground="{DynamicResource OkBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="MonthLabel" Text="This month" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="StatMonth" Style="{StaticResource StatValue}" />
                        <TextBlock x:Name="StatMonthSub" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- status row -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Open jobs" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="StatOpen" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Waiting on me" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="StatWaitMe" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0">
                    <StackPanel>
                        <TextBlock x:Name="WaitAgencyLabel" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="StatWaitAgency" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="WaitClientLabel" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="StatWaitHo" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Outstanding invoices" Style="{StaticResource H2}" />
                        <DataGrid x:Name="ReceivablesGrid" MaxHeight="360" MouseDoubleClick="Receivables_Open">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Job" Binding="{Binding Job}" Width="*" />
                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="90" />
                                <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate}" Width="95" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=C}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="ReceivablesEmpty" Text="Nothing outstanding — you're all caught up."
                                   Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Jobs by current stage" Style="{StaticResource H2}" />
                            <ItemsControl x:Name="StageList" />
                            <TextBlock x:Name="StageEmpty" Text="No jobs in progress." Style="{StaticResource Muted}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Recent activity" Style="{StaticResource H2}" />
                            <ItemsControl x:Name="ActivityList" />
                            <TextBlock x:Name="ActivityEmpty" Text="Nothing logged yet." Style="{StaticResource Muted}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
