<UserControl x:Class="FieldJobs.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28,24">
        <TextBlock DockPanel.Dock="Top" Text="Reports" Style="{StaticResource H1}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Filters -->
            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Report" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="TypeBox" SelectionChanged="Type_Changed" />

                    <StackPanel x:Name="RangePanel">
                        <TextBlock Text="Date range" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="PresetBox" SelectionChanged="Preset_Changed" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="FromBox" Grid.Column="0" SelectedDateChanged="Dates_Changed" />
                            <DatePicker x:Name="ToBox" Grid.Column="2" SelectedDateChanged="Dates_Changed" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="MonthPanel" Visibility="Collapsed">
                        <TextBlock Text="Month" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="MonthBox" Grid.Column="0" />
                            <ComboBox x:Name="YearBox" Grid.Column="2" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Project types" Style="{StaticResource FieldLabel}" />
                    <StackPanel x:Name="ProjectTypesPanel" />

                    <TextBlock Text="Prepared for" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ContactBox" />
                    <TextBlock Text="Manage contacts in Settings." Style="{StaticResource Muted}" Margin="0,3,0,0" />

                    <Button Content="Refresh preview" Margin="0,14,0,0" Click="Refresh_Click" />
                </StackPanel>
            </Border>

            <!-- Preview + actions -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock x:Name="PreviewTitle" Style="{StaticResource H2}" Margin="0" />
                    <TextBlock x:Name="PreviewSummary" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                </StackPanel>

                <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="Generate PDF" Style="{StaticResource Primary}" Click="Pdf_Click" Margin="0,0,8,8" />
                    <Button Content="Generate Excel" Click="Excel_Click" Margin="0,0,8,8" />
                    <Button x:Name="PerStatusButton" Content="Separate PDF per status" Click="PerStatus_Click"
                            Margin="0,0,8,8" />
                </WrapPanel>

                <Border Style="{StaticResource Card}" Padding="0">
                    <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="True" IsReadOnly="True"
                              HeadersVisibility="Column" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
