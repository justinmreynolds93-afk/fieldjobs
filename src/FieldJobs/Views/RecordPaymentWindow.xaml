<Window x:Class="FieldJobs.Views.RecordPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record payment" Height="520" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}">
    <DockPanel Margin="22">
        <TextBlock DockPanel.Dock="Top" Text="Record a payment" Style="{StaticResource H1}" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" MinWidth="90" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" />
            <Button Content="Record payment" Style="{StaticResource Primary}" MinWidth="140" Click="Save_Click" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Invoice" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="InvoiceBox" SelectionChanged="Invoice_Changed" />
            <TextBlock x:Name="BalanceText" Style="{StaticResource Muted}" Margin="0,4,0,0" />

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Payment date" Style="{StaticResource FieldLabel}" />
                    <DatePicker x:Name="DateBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Amount received" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="AmountBox" />
                </StackPanel>
            </Grid>

            <CheckBox x:Name="FullBalanceBox" Content="Pay the full remaining balance" Margin="0,10,0,0"
                      Checked="FullBalance_Toggled" Unchecked="FullBalance_Toggled" />

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Method" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="MethodBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Reference (check # / ACH trace)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ReferenceBox" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Note" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" />

            <TextBlock Text="Tip: attach the remittance / proof of payment on the invoice's Documents section after recording."
                       Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</Window>
