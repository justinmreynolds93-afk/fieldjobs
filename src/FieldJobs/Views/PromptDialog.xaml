<Window x:Class="FieldJobs.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FieldJobs" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="Input" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" MinWidth="84" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" />
            <Button Content="OK" MinWidth="84" Style="{StaticResource Primary}" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
