<UserControl x:Class="FieldJobs.Views.StageCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
            <!-- header -->
            <DockPanel>
                <TextBlock x:Name="LockGlyph" DockPanel.Dock="Left" Text="&#128274;" FontSize="15"
                           Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"
                           ToolTip="Locked" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Status" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="StatusBox" Width="130" SelectionChanged="StatusBox_Changed" />
                    <TextBlock Text="Done" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <DatePicker x:Name="DoneDate" Width="130" SelectedDateChanged="DoneDate_Changed" />
                </StackPanel>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            </DockPanel>

            <TextBlock x:Name="OptionalTag" Text="Optional stage — set to N/A if it does not apply."
                       Style="{StaticResource Muted}" Margin="0,2,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="LockText" Foreground="{DynamicResource WarnBrush}" FontSize="12"
                       Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            <TextBlock x:Name="FileWarn" Foreground="{DynamicResource WarnBrush}" FontSize="12"
                       Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                       Text="This stage is marked complete but has no file attached." />

            <!-- body (dimmed when locked) -->
            <StackPanel x:Name="Body" Margin="0,10,0,0">
                <TextBlock Text="Checklist" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                <ItemsControl x:Name="ChecklistItems" />
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="Add" MinWidth="60" Click="AddItem_Click" />
                    <TextBox x:Name="NewItemBox" Margin="0,0,8,0" />
                </DockPanel>

                <TextBlock Text="Stage notes" Style="{StaticResource Muted}" Margin="0,12,0,4" />
                <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52"
                         LostFocus="NotesBox_LostFocus" />

                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Content="Attach file" Click="Attach_Click" MinWidth="90" />
                    <TextBlock Text="Files for this stage" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl x:Name="StageFiles" Margin="0,4,0,0" />

                <Button x:Name="InvoiceButton" Content="Invoice this stage" Style="{StaticResource Primary}"
                        HorizontalAlignment="Left" Margin="0,14,0,0" Click="Invoice_Click" />
                <TextBlock x:Name="InvoicedHint" Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
