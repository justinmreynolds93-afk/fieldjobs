<Window x:Class="FieldJobs.Views.JobEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Job" Height="720" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        ResizeMode="CanResize" MinWidth="520" MinHeight="560">
    <DockPanel Margin="22">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" Text="New job" Style="{StaticResource H1}" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button x:Name="DeleteButton" Content="Delete job" Style="{StaticResource Danger}" MinWidth="110"
                    DockPanel.Dock="Left" Click="Delete_Click" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="90" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True" />
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource Primary}" MinWidth="110" Click="Save_Click" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,4,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Job number" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="JobNumber" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="Ref1LabelText" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ExternalRef1" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock x:Name="Ref2LabelText" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ExternalRef2" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Property street address" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="Street" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="City" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="City" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ZIP" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="Zip" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ClientLabelText" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="Client" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Project type" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ProjectType" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Date assigned" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="DateAssigned" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="Status" />

                <TextBlock Text="My role on this job (inspection, scope writing, final walkthrough, etc.)"
                           Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="RoleNotes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />

                <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="Notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />

                <TextBlock Text="Do not record SSN, income, or grant-eligibility data in this app."
                           Style="{StaticResource Muted}" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
